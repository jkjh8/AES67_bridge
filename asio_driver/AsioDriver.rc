#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AES67B_VER_MAJOR,AES67B_VER_MINOR,AES67B_VER_PATCH,0
 PRODUCTVERSION AES67B_VER_MAJOR,AES67B_VER_MINOR,AES67B_VER_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AES67 Bridge"
      VALUE "FileDescription", "AES67 Bridge virtual ASIO driver (32 in / 32 out)"
      VALUE "FileVersion", AES67B_VERSION
      VALUE "ProductName", "AES67 Bridge"
      VALUE "ProductVersion", AES67B_VERSION
      VALUE "LegalCopyright", "GPLv3 (Steinberg ASIO SDK)"
      VALUE "OriginalFilename", "AES67BridgeASIO.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
