#include "resource.h"
#include <winver.h>
#include "version.h"

IDI_APPICON ICON "app.ico"

IDR_WEBUI RCDATA "web/index.html"
IDR_LICENSE RCDATA "../../LICENSE"
IDR_NOTICES RCDATA "../../THIRD_PARTY_NOTICES.txt"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AES67B_VER_MAJOR,AES67B_VER_MINOR,AES67B_VER_PATCH,0
 PRODUCTVERSION AES67B_VER_MAJOR,AES67B_VER_MINOR,AES67B_VER_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AES67 Bridge"
      VALUE "FileDescription", "AES67 Bridge (Windows Audio over IP)"
      VALUE "FileVersion", AES67B_VERSION
      VALUE "ProductName", "AES67 Bridge"
      VALUE "ProductVersion", AES67B_VERSION_FULL
      VALUE "LegalCopyright", "Copyright (C) 2026 jkjh8. Licensed under GPLv3."
      VALUE "OriginalFilename", "AES67Bridge.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
